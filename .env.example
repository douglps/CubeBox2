# =============================================================================
# CubeBox Enterprise - Template de Variáveis de Ambiente (Environment Example)
# =============================================================================

# Ambiente de Execução (development | production | test)
APP_ENV=development

# -----------------------------------------------------------------------------
# Banco de Dados (Database Connection)
# -----------------------------------------------------------------------------
# Exemplo 1: Desenvolvimento Local (SQLite padrão)
DATABASE_URL=sqlite:///data/cubebox.db

# Exemplo 2: Produção na VPS Oracle Cloud (MySQL 8.0+)
# Substitua pelo seu usuário, senha forte e IP/Host da máquina virtual
# DATABASE_URL=mysql+pymysql://cubebox_user:SuaSenhaForte123!@127.0.0.1:3306/cubebox?charset=utf8mb4

# -----------------------------------------------------------------------------
# Servidor FastAPI
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Origens permitidas para requisições no Frontend (separadas por vírgula)
# Em produção, adicione o IP público ou domínio da sua VPS Oracle
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Pool de Conexões (Configurações de Produção para MySQL)
# -----------------------------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
